# ---- Banco ----
# Postgres (produção / docker compose)
DATABASE_URL=postgresql+asyncpg://askdoc:askdoc@localhost:5432/askdoc
# SQLite (para rodar sem Docker): sqlite+aiosqlite:///./askdoc.db

# ---- Provider de IA ----
# fake      -> embeddings determinísticos + respostas extrativas, sem chave, sem custo (default)
# openai    -> requer OPENAI_API_KEY
# anthropic -> requer ANTHROPIC_API_KEY (embeddings continuam via OpenAI ou fake)
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Dimensão dos embeddings. fake=256, text-embedding-3-small=1536
EMBEDDING_DIM=256

# ---- Retrieval ----
USE_PGVECTOR=false          # true quando o Postgres tiver a extensão vector instalada
CHUNK_SIZE=900              # caracteres por chunk
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CANDIDATE_POOL=40           # candidatos por estratégia antes da fusão RRF

# ---- API ----
ADMIN_TOKEN=troque-isto-em-producao
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO
